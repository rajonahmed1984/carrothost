# CarrotHost - Apache SPA Routing
# Upload this file to the root of your public_html directory

# Fallback: Route Apache 404 errors directly to the main 404 page
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Never expose an auto-generated directory listing. Without this, /assets/ was
# served as a browsable index that Google crawled and indexed.
Options -Indexes

# Enable rewrite engine
RewriteEngine On

# Use one origin for every indexable URL: HTTPS without www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^carrothost\.com$ [NC]
RewriteRule ^ https://carrothost.com%{REQUEST_URI} [R=301,L,NE]

# Prevent explicit index.html URLs from competing with clean directory URLs.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[\s?]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

# Hidden files (.htaccess, .env, .git/...) answer 404 rather than 403, so a
# crawler that stumbles on one drops the URL instead of reporting it as blocked.
# /.well-known/ stays reachable for TLS and verification files.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [R=404,L]

# A directory with no index.html (e.g. /assets/) is not a page. Answer 404
# instead of letting the server return a listing or a 403.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

# If the requested file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Return a real 404 status; ErrorDocument above supplies the designed page.
RewriteRule ^ - [R=404,L]

# ============================================================
# Performance: Browser caching for static assets
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On

    # CSS & JS — hashed filenames, cache for 1 year
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images — cache for 1 month
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts — cache for 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # HTML — no cache (always fresh)
    ExpiresByType text/html "access plus 0 seconds"

    # XML/JSON
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ============================================================
# Compression: Gzip for faster loading
# ============================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ============================================================
# Security headers
# ============================================================

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
